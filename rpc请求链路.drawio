        </mxCell>
        <mxCell id="Go6kUv1zIBEceRwhiAK9-14" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;注意：&lt;/h1&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;DeviceActor 和 Transport service&amp;nbsp; Session 是怎么管理的？什么时候会建立会话。&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="50" y="150" width="180" height="120" as="geometry" />
        </mxCell>
